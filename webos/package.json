{
  "name": "resona-webos",
  "version": "0.1.2",
  "private": true,
  "description": "Resona artwork receiver for rooted LG webOS TVs",
  "license": "GPL-3.0-only",
  "scripts": {
    "test": "node --test tests/server.test.js",
    "test:browser": "node tests/browser.js",
    "assets": "node scripts/assets.js",
